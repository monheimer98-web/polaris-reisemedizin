---
/**
 * Angebotsseite „Prävention & Lebensstil" (Deutsch) — dynamische Route über die
 * jetzt buchbaren Angebote (Stufe 1). Darstellung über ContentLayout im Bereich
 * `praevention` (Salbei, Bereichsnavigation); identisch zur EN-Variante.
 */
import type { GetStaticPaths } from 'astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import PraeventionAngebot from '../../components/PraeventionAngebot.astro';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';
import { getSources } from '../../data/sources';
import { allPreventionOffers, preventionHub, preventionOffers, preventionPath } from '../../data/praevention';
import type { PreventionOffer } from '../../data/praevention/types';

export const getStaticPaths = (() =>
  preventionOffers.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }))) satisfies GetStaticPaths;

interface Props {
  offer: PreventionOffer;
}

const { offer } = Astro.props;
const page = offer.page;
const lang = getLangFromUrl(Astro.url);
// Stufe-2-Angebote haben noch keine Seite: Links dorthin weglassen (sonst 404).
const unveroeffentlicht = new Set(allPreventionOffers.filter((o) => o.stage !== 1).map((o) => preventionPath(o.slug)));
const related = (page.related ?? [])
  .filter((item) => !unveroeffentlicht.has(item.path))
  .map((item) => ({ label: item.label[lang], path: getLocalizedPath(item.path, lang) }));
const faq = (page.faq ?? []).map((f) => ({ q: f.q[lang], a: f.a[lang] }));
---

<ContentLayout
  title={page.meta.title[lang]}
  description={page.meta.description[lang]}
  eyebrow={page.meta.eyebrow[lang]}
  lead={page.meta.lead[lang]}
  lastReviewed={page.lastReviewed}
  sources={getSources(page.sourceIds)}
  related={related}
  faq={faq}
  bookingType={offer.bookingType}
  bookingLabel={offer.bookingLabel?.[lang]}
  secondaryBooking={offer.secondaryBooking ? { type: offer.secondaryBooking.type, label: offer.secondaryBooking.label[lang] } : undefined}
  area="praevention"
  areaCurrent={offer.slug}
  cta={{ title: preventionHub.ctaTitle[lang], lead: preventionHub.ctaLead[lang], note: preventionHub.ctaNote[lang] }}
>
  <PraeventionAngebot offer={offer} />
</ContentLayout>
