---
/**
 * Übersicht „Leistungen" (Deutsch) — Eltern-Seite der Navigation. Dünne Seite:
 * LeistungenContent rendert die Leistungen in drei Gruppen (Sprache aus der URL),
 * CTA schließt ab. Identisch zur EN-Variante.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeistungenContent from '../../components/LeistungenContent.astro';
import CTA from '../../components/CTA.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('overview.servicesTitle')} description={t('overview.servicesMeta')}>
  <LeistungenContent />
  <CTA />
</BaseLayout>
