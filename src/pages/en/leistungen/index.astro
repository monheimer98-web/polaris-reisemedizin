---
/**
 * Services overview (English) — parent navigation page. Thin page:
 * LeistungenContent renders the services in three groups (language from the URL),
 * CTA closes. Identical to the German variant.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LeistungenContent from '../../../components/LeistungenContent.astro';
import CTA from '../../../components/CTA.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('overview.servicesTitle')} description={t('overview.servicesMeta')}>
  <LeistungenContent />
  <CTA />
</BaseLayout>
