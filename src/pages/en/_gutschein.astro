---
/**
 * Gift voucher (English).
 * Ohne Buchungsknopf, weil der Gutschein nie an einen Termin gebunden wird.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import ClinicalSections from '../../components/ClinicalSections.astro';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';
import { getSources } from '../../data/sources';
import { gutscheinPage as page } from '../../data/ausland/gutschein';

const lang = getLangFromUrl(Astro.url);
const related = (page.related ?? []).map((item) => ({ label: item.label[lang], path: getLocalizedPath(item.path, lang) }));
const faq = (page.faq ?? []).map((f) => ({ q: f.q[lang], a: f.a[lang] }));
---

<ContentLayout
  title={page.meta.title[lang]}
  description={page.meta.description[lang]}
  eyebrow={page.meta.eyebrow[lang]}
  lead={page.meta.lead[lang]}
  lastReviewed={page.lastReviewed}
  sources={getSources(page.sourceIds)}
  related={related}
  faq={faq}
  noBooking
>
  <ClinicalSections page={page} />
</ContentLayout>
