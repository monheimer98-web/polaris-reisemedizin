---
/**
 * Startseiten-Weiche: zwei gleich große Einstiege in die beiden Bereiche der
 * einen Praxis – „Reisemedizin & Impfungen" (Petrol) und „Prävention &
 * Lebensstil" (Salbei). Steht direkt unter dem Hero, damit niemand erst
 * scrollen muss, um den eigenen Bereich zu finden. Sprache aus der URL.
 */
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { travelServicesNav } from '../config/nav';
import type { UiKey } from '../i18n/ui';
import { PREVENTION_PATH, preventionOffers, preventionPath } from '../data/praevention';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const de = lang === 'de';

const bereiche = [
  {
    theme: undefined,
    title: de ? 'Reisemedizin & Impfungen' : 'Travel medicine & vaccinations',
    text: de
      ? 'Reiseberatung mit schriftlichem Reiseplan, Reiseimpfungen, Gelbfieber, Malaria und Höhe – auch abends und samstags.'
      : 'Travel health advice with a written travel plan, travel vaccinations, yellow fever, malaria and altitude – also evenings and Saturdays.',
    links: (travelServicesNav.children ?? []).slice(0, 4).map((c) => ({ label: t(c.labelKey as UiKey), path: c.path })),
    cta: de ? 'Zur Reisemedizin' : 'Go to travel medicine',
    path: '/leistungen',
  },
  {
    theme: 'theme-praevention',
    title: de ? 'Prävention & Lebensstil' : 'Prevention & lifestyle',
    text: de
      ? 'Gesundheitscheck, Begleitung bei Gewicht und Stoffwechsel, Sprechstunde Wechseljahre und das Einordnen Ihrer Werte – mit Zeit und schriftlichem Plan.'
      : 'Health check-up, support for weight and metabolism, a menopause consultation and help making sense of your results – with time and a written plan.',
    links: preventionOffers.slice(0, 4).map((o) => ({ label: o.shortName[lang], path: preventionPath(o.slug) })),
    cta: de ? 'Zu Prävention & Lebensstil' : 'Go to prevention & lifestyle',
    path: PREVENTION_PATH,
  },
];
---

<section class="u-container -mt-10 relative z-10 pb-6 sm:-mt-14" aria-label={de ? 'Bereiche der Praxis' : 'Areas of the practice'}>
  <div class="grid gap-5 md:grid-cols-2">
    {
      bereiche.map((b) => (
        <div class:list={[b.theme]}>
          <div class="flex h-full flex-col rounded-3xl border border-petrol-100 bg-white p-6 shadow-[var(--shadow-card)] sm:p-8">
            <p class="eyebrow">
              <span class="h-2 w-2 rounded-full bg-petrol-500" aria-hidden="true"></span>
              {de ? 'Bereich' : 'Area'}
            </p>
            <h2 class="mt-3 text-2xl sm:text-3xl">{b.title}</h2>
            <p class="mt-3 flex-1 text-ink-soft">{b.text}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {b.links.map((l) => (
                <li>
                  <a
                    href={getLocalizedPath(l.path, lang)}
                    class="inline-flex rounded-full border border-petrol-100 bg-petrol-50/60 px-3 py-1.5 text-sm font-medium text-petrol-800 transition-colors hover:border-gold-300"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
            <a href={getLocalizedPath(b.path, lang)} class="btn-primary mt-6 self-start">
              {b.cta}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
