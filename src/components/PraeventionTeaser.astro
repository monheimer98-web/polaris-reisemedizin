---
/**
 * Hinweis auf „Prävention & Lebensstil" auf „Kosten & Abrechnung", als
 * Salbei-Band: typische Kosten je Angebot (ohne Lockpreis) und Link auf die
 * Beispielkosten. Sprache aus der URL.
 */
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import { PREVENTION_COSTS_PATH, preventionHub, preventionOffers, preventionPath } from '../data/praevention';

const lang = getLangFromUrl(Astro.url);
const de = lang === 'de';
---

<section class="theme-praevention u-container pt-12 sm:pt-14">
  <div class="rounded-3xl border border-petrol-100 bg-petrol-50/80 p-6 sm:p-10">
    <p class="eyebrow"><span class="rule-gold"></span>{de ? 'Prävention' : 'Prevention'}</p>
    <h2 class="mt-4 text-2xl sm:text-3xl">{de ? 'Kosten in der Prävention' : 'Costs for prevention'}</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">{preventionHub.ctaNote[lang]}</p>
    <dl class="mt-6 divide-y divide-petrol-100 rounded-2xl border border-petrol-100 bg-white">
      {
        preventionOffers.map((o) => (
          <div class="grid gap-1 px-5 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <dt>
              <a
                href={getLocalizedPath(preventionPath(o.slug), lang)}
                class="font-semibold text-petrol-900 underline decoration-gold-400/50 underline-offset-4"
              >
                {o.shortName[lang]}
              </a>
            </dt>
            <dd class="text-sm leading-relaxed text-ink-soft">
              {o.facts.fee[lang]} {de ? 'Zusätzlich Laborkosten' : 'Additional lab costs'}: {o.facts.lab[lang]}.
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-6">
      <a href={getLocalizedPath(PREVENTION_COSTS_PATH, lang)} class="btn-ghost">
        {de ? 'Beispielkosten für Gesundheitscheck, Wechseljahre und Gewicht' : 'Example fees for check-ups, menopause and weight'}
      </a>
    </p>
  </div>
</section>
