---
/**
 * Globale Kopfzeile: Marke, Hauptnavigation (mit Untermenüs), Sprachumschalter
 * und Buchungs-CTA. Mobil als zugängliches Off-Canvas-Menü.
 */
import { primaryNav, preventionNav, BOOKING_PATH } from '../config/nav';
import { PREVENTION_BOOKING_PATH, preventionOffers } from '../data/praevention';
import { WELT_START, type Welt } from '../lib/welt';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import { site } from '../config/site';
import type { UiKey } from '../i18n/ui';
import type { NavItem } from '../config/nav';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  /** Themenwelt der Seite: bestimmt Menü, Buchungsziel und Umschalter. */
  welt?: Welt;
}

const { welt = 'reise' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const homeHref = getLocalizedPath('/', lang);
const bookingHref = getLocalizedPath(welt === 'praevention' ? PREVENTION_BOOKING_PATH : BOOKING_PATH, lang);
const hatHaare = preventionOffers.some((o) => o.slug === 'haare');
const navItems = welt === 'praevention' ? preventionNav(hatHaare) : primaryNav;
/* Feste Farben je Welt. Das jeweils andere Feld ist in seiner Farbe getönt und
   umrandet, damit es als zweite Wahl sofort auffällt. */
const welten: { id: Welt; labelKey: UiKey; aktiv: string; ruhig: string; icon: string }[] = [
  {
    id: 'reise',
    labelKey: 'nav.worldTravel',
    aktiv: 'bg-[#0e3b43] text-white shadow-sm',
    ruhig: 'bg-[#edf5f5] text-[#0e3b43] ring-1 ring-inset ring-[#0e3b43]/20 hover:bg-[#d2e6e6]',
    icon: 'M14 2 2 7.2l5.1 1.7L8.8 14 14 2Z',
  },
  {
    id: 'praevention',
    labelKey: 'nav.worldPrevention',
    aktiv: 'bg-[#29402c] text-white shadow-sm',
    ruhig: 'bg-[#f1f5ef] text-[#29402c] ring-1 ring-inset ring-[#29402c]/25 hover:bg-[#dfe9dc]',
    icon: 'M13.5 2.5c-6.4 0-10 3-10 7.3 0 1.4.4 2.6 1.2 3.4C6 10 8.4 7.9 11 6.6 8.7 8.2 6.6 10.6 5.6 13.6c.7.3 1.4.4 2.2.4 4.4 0 5.7-4.4 5.7-11.5Z',
  },
];
/* Kurzer Hinweis neben dem Umschalter: was im anderen Bereich zu finden ist. */
const listeDe = (teile: string[]) => (teile.length > 1 ? `${teile.slice(0, -1).join(', ')} und ${teile[teile.length - 1]}` : teile.join(''));
const listeEn = (teile: string[]) => (teile.length > 1 ? `${teile.slice(0, -1).join(', ')} and ${teile[teile.length - 1]}` : teile.join(''));
const andereWelt: Welt = welt === 'praevention' ? 'reise' : 'praevention';
const weltHinweis =
  andereWelt === 'praevention'
    ? lang === 'de'
      ? listeDe(['Gesundheitscheck', 'Laborwerte', 'Ernährung', ...(hatHaare ? ['Haare'] : [])])
      : listeEn(['Health check-up', 'blood tests', 'nutrition', ...(hatHaare ? ['hair'] : [])])
    : lang === 'de'
      ? 'Reiseberatung, Reiseimpfungen und Gelbfieber'
      : 'Travel advice, travel vaccinations and yellow fever';
const toneClass: Record<NonNullable<NavItem['tone']>, string> = {
  reise: 'text-[#0e3b43]',
  praevention: 'text-[#29402c]',
};
const toneDot: Record<NonNullable<NavItem['tone']>, string> = {
  reise: 'bg-[#c9a24b]',
  praevention: 'bg-[#8fb08a]',
};

function isActive(path: string): boolean {
  const localized = (getLocalizedPath(path, lang).replace(/\/+$/, '') || '/');
  if (localized === '/') return currentPath === '/';
  return currentPath === localized || currentPath.startsWith(localized + '/');
}

/** Hauptpunkt aktiv? Bei `exact` nur auf genau dieser Seite oder bei aktivem Unterpunkt. */
function isItemActive(item: NavItem): boolean {
  if (!item.exact) return isActive(item.path);
  const localized = (getLocalizedPath(item.path, lang).replace(/\/+$/, '') || '/');
  return currentPath === localized || (item.children ?? []).some((c) => !c.tone && isActive(c.path));
}

/** Ab lg (1024 px) sichtbar: Leistungen, Kosten, Kontakt. Der Rest erst ab xl, darunter im Menü. */
function isKern(item: NavItem, i: number): boolean {
  return i === 0 || item.labelKey === 'nav.costs' || item.labelKey === 'nav.contact';
}
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-petrol-800 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-cream">
  {t('skip.toContent')}
</a>

<header class="sticky top-0 z-40 border-b border-petrol-100/70 bg-gradient-to-b from-petrol-50/90 to-cream/85 backdrop-blur-md">
  {/* Feine goldene Markenkante — dezenter Premium-Akzent */}
  <div class="h-[3px] w-full bg-gradient-to-r from-gold-300/0 via-gold-400 to-gold-300/0" aria-hidden="true"></div>
  {/* Umschalter zwischen den beiden Themenwelten derselben Praxis: zwei deutliche Felder
      ganz oben, am Handy über die volle Breite. Daneben (ab lg) ein kurzer Hinweis, was im
      anderen Bereich zu finden ist. Feste Farben (nicht die umgemappten Petrol-Stufen),
      damit jede Welt ihre Farbe behält. Höhe: am Handy 44 px, ab sm 40 px; die Kopfzeile
      bleibt damit unter scroll-mt-32 (128 px). */}
  <nav class="border-b border-black/5 bg-white/70" aria-label={t('nav.worldSwitch')}>
    <div class="mx-auto flex h-11 w-full max-w-7xl items-center gap-3 px-5 sm:h-10 sm:px-8">
      <span class="hidden shrink-0 text-xs font-medium text-ink-soft sm:inline" aria-hidden="true">{t('nav.worldSwitch')}:</span>
      <div class="grid w-full grid-cols-2 gap-1 rounded-full bg-black/[0.05] p-1 sm:inline-grid sm:w-auto">
        {welten.map((w) => (
          <a
            href={getLocalizedPath(WELT_START[w.id], lang)}
            class:list={['inline-flex h-8 items-center justify-center gap-2 whitespace-nowrap rounded-full px-4 text-sm font-semibold transition-colors sm:h-7', welt === w.id ? w.aktiv : w.ruhig]}
            aria-current={welt === w.id ? 'true' : undefined}
          >
            <svg
              class:list={['h-3.5 w-3.5 shrink-0', welt === w.id && (w.id === 'reise' ? 'text-[#c9a24b]' : 'text-[#8fb08a]')]}
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={w.icon} />
            </svg>
            {t(w.labelKey)}
          </a>
        ))}
      </div>
      <a
        href={getLocalizedPath(WELT_START[andereWelt], lang)}
        class:list={['hidden min-w-0 items-center gap-1.5 truncate text-xs font-medium transition-opacity hover:opacity-75 lg:inline-flex', toneClass[andereWelt]]}
      >
        <span class="truncate">{weltHinweis}</span>
        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 8h9M9 5l3 3-3 3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </nav>
  {/* Eigene, etwas breitere Container-Breite als der Inhalt (max-w-7xl statt
      max-w-6xl): Die achtteilige Navigation plus Marke, Sprachumschalter und CTA
      braucht im gedeckelten Raster mehr Luft. Ein etwas breiterer Kopfbalken als
      die Inhaltsspalte ist ein etabliertes, ruhiges Premium-Muster. */}
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-5 sm:h-20 sm:px-8">
    {/* Marke — shrink-0, damit der Schriftzug nie in die Navigation gestaucht wird.
        Die (breite, gesperrte) Tagline erscheint nur dort, wo Platz ist: auf
        Tablet (sm bis unter lg). Ab lg steht dort die Navigation (lg: Leistungen,
        Kosten, Kontakt; ab xl alle Punkte), dann bleibt sie aus, sonst kollidiert
        sie mit „Leistungen". whitespace-nowrap verhindert das Umbrechen. */}
    <a href={homeHref} class="group flex shrink-0 items-center gap-2.5" aria-label={`${site.brand.name} — ${t('nav.home')}`}>
      <Logo class="h-9 w-9 shrink-0 sm:h-10 sm:w-10" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-semibold tracking-tight text-petrol-900 sm:text-xl">{site.brand.name}</span>
        <span class="hidden whitespace-nowrap text-[0.66rem] font-medium uppercase tracking-[0.16em] text-petrol-500 sm:block lg:hidden">
          {site.brand.tagline[lang]}
        </span>
      </span>
    </a>

    {/* Desktop-Navigation — voll erst ab xl (≥1280px), da die achtteilige, zweisprachige
        Leiste (Marke + Untermenüs + Sprache + CTA) darunter zu breit wird und im EN-Layout
        sonst überliefe. Zwischen lg und xl stehen nur Leistungen, Kosten und Kontakt hier
        (Leistungen als Link ohne Untermenü, das breite Menü passt dort nicht); alle Punkte
        bleiben über das Menü-Symbol erreichbar. */}
    <nav class="hidden items-center gap-0.5 lg:flex" aria-label={t('header.primaryNav')}>
      {
        navItems.map((item, i) =>
          item.children?.length ? (
            <div class:list={['group relative', !isKern(item, i) && 'hidden xl:block']}>
              <a
                href={getLocalizedPath(item.path, lang)}
                class:list={[
                  'inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-2 text-sm font-medium transition-colors hover:bg-white',
                  isItemActive(item) ? 'text-petrol-900' : 'text-ink-soft hover:text-petrol-900',
                ]}
                aria-current={isItemActive(item) ? 'page' : undefined}
              >
                {t(item.labelKey as UiKey)}
                <svg class="hidden h-3.5 w-3.5 opacity-60 transition-transform group-hover:rotate-180 xl:block" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <div
                class:list={[
                  'invisible absolute left-0 top-full z-30 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 max-xl:hidden',
                  item.groups?.length ? 'w-max' : 'w-max min-w-[15rem] max-w-[22rem]',
                ]}
              >
                {item.groups?.length ? (
                  /* Gegliedertes Untermenü: Gruppen nebeneinander, damit es breit und flach
                     statt lang aufgeht; unten Ablauf und der Weg zur ganzen Übersicht. */
                  <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-[var(--shadow-card)]">
                    <div class="flex p-2">
                      {item.groups.map((group, g) => (
                        <div class:list={['min-w-[13rem] px-1', g > 0 && 'border-l border-line/70']}>
                          <p
                            id={`nav-gruppe-${g}`}
                            class="whitespace-nowrap px-3.5 pb-1.5 pt-3 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-petrol-500"
                          >
                            {t(group.labelKey as UiKey)}
                          </p>
                          <ul aria-labelledby={`nav-gruppe-${g}`}>
                            {group.items.map((child) => (
                              <li>
                                <a
                                  href={getLocalizedPath(child.path, lang)}
                                  class:list={[
                                    'block whitespace-nowrap rounded-xl px-3.5 py-2 text-sm transition-colors hover:bg-cream',
                                    isActive(child.path) ? 'font-semibold text-petrol-900' : 'text-ink-soft hover:text-petrol-900',
                                  ]}
                                  aria-current={isActive(child.path) ? 'page' : undefined}
                                >
                                  {t(child.labelKey as UiKey)}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    <div class="flex items-center gap-6 border-t border-line bg-cream/70 px-6 py-3 text-sm">
                      {item.more?.map((extra) =>
                        extra.tone ? (
                          <a
                            href={getLocalizedPath(extra.path, lang)}
                            class:list={['inline-flex items-center gap-2 font-semibold transition-opacity hover:opacity-75', toneClass[extra.tone]]}
                          >
                            <span class:list={['h-2 w-2 rounded-full', toneDot[extra.tone]]} aria-hidden="true"></span>
                            {t(extra.labelKey as UiKey)}
                          </a>
                        ) : (
                          <a
                            href={getLocalizedPath(extra.path, lang)}
                            class:list={[
                              'transition-colors hover:text-petrol-900',
                              isActive(extra.path) ? 'font-semibold text-petrol-900' : 'text-ink-soft',
                            ]}
                            aria-current={isActive(extra.path) ? 'page' : undefined}
                          >
                            {t(extra.labelKey as UiKey)}
                          </a>
                        )
                      )}
                      <a
                        href={getLocalizedPath(item.path, lang)}
                        class="ml-auto inline-flex items-center gap-1.5 font-semibold text-petrol-700 transition-colors hover:text-petrol-900"
                      >
                        {t('nav.allServices')}
                        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                          <path d="M3 8h9M9 5l3 3-3 3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    </div>
                  </div>
                ) : (
                  <ul class="overflow-hidden rounded-2xl border border-line bg-white p-1.5 shadow-[var(--shadow-card)]">
                    {item.children.map((child) =>
                      child.tone ? (
                        <li class="mt-1 border-t border-line pt-1">
                          <a
                            href={getLocalizedPath(child.path, lang)}
                            class:list={['flex items-center gap-2 whitespace-nowrap rounded-xl px-3.5 py-2.5 text-sm font-semibold transition-colors hover:bg-cream', toneClass[child.tone]]}
                          >
                            <span class:list={['h-2 w-2 rounded-full', toneDot[child.tone]]} aria-hidden="true"></span>
                            {t(child.labelKey as UiKey)}
                          </a>
                        </li>
                      ) : (
                        <li>
                          <a
                            href={getLocalizedPath(child.path, lang)}
                            class:list={[
                              'block rounded-xl px-3.5 py-2.5 text-sm transition-colors hover:bg-cream',
                              isActive(child.path) ? 'font-semibold text-petrol-900' : 'text-ink-soft hover:text-petrol-900',
                            ]}
                            aria-current={isActive(child.path) ? 'page' : undefined}
                          >
                            {t(child.labelKey as UiKey)}
                          </a>
                        </li>
                      )
                    )}
                  </ul>
                )}
              </div>
            </div>
          ) : (
            <a
              href={getLocalizedPath(item.path, lang)}
              class:list={[
                'whitespace-nowrap rounded-full px-2.5 py-2 text-sm font-medium transition-colors hover:bg-white',
                isItemActive(item) ? 'text-petrol-900' : 'text-ink-soft hover:text-petrol-900',
                !isKern(item, i) && 'hidden xl:inline',
              ]}
              aria-current={isItemActive(item) ? 'page' : undefined}
            >
              {t(item.labelKey as UiKey)}
            </a>
          )
        )
      }
    </nav>

    {/* Rechts: Anrufen + Sprache + CTA + Mobile-Toggle */}
    <div class="flex items-center gap-2 sm:gap-3">
      {/* Klick-zum-Anrufen — kompaktes Icon auf allen Größen (mobil: Tap-to-Call);
          die Nummer steht im Tooltip/aria-Label sowie in Fußzeile, Kontakt & Termin. */}
      <a
        href={site.contact.phoneHref}
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-petrol-800 transition-colors hover:bg-white"
        aria-label={`${t('cta.callAria')}: ${site.contact.phone}`}
        title={site.contact.phone}
      >
        <svg class="h-[1.15rem] w-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <div class="hidden sm:block">
        <LanguageSwitcher />
      </div>
      {/* Auf dem Handy bleibt der Weg zur Buchung in der mitlaufenden Kopfzeile sichtbar. */}
      <a href={bookingHref} class="btn-gold inline-flex h-10 px-3 text-sm sm:hidden" aria-label={t('cta.bookAria')}>
        {t('cta.bookShort')}
      </a>
      <a href={bookingHref} class="btn-gold hidden h-10 whitespace-nowrap px-4 sm:inline-flex" aria-label={t('cta.bookAria')}>
        {t('cta.book')}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-petrol-800 transition-colors hover:bg-white xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('header.openMenu')}
        data-label-open={t('header.openMenu')}
        data-label-close={t('header.closeMenu')}
      >
        <svg class="menu-icon-open h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <svg class="menu-icon-close hidden h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile-Menü — Akkordeon: Untermenüs sind eingeklappt und per Pfeil aufklappbar,
      damit die lange Liste (u. a. 12 Krankheitsbilder) kompakt und übersichtlich bleibt.
      Höhe auf den Bildschirm begrenzt und in sich scrollbar: Die Kopfzeile klebt oben, ein
      längeres aufgeklapptes Menü wäre sonst unten nicht erreichbar. */}
  <div
    id="mobile-menu"
    class="hidden max-h-[calc(100dvh-7.0625rem)] overflow-y-auto overscroll-contain border-t border-line bg-cream sm:max-h-[calc(100dvh-7.8125rem)] xl:hidden"
  >
    <nav class="mx-auto flex w-full max-w-7xl flex-col px-5 py-2 sm:px-8" aria-label={t('header.primaryNav')}>
      {
        navItems.map((item, i) => (
          <div class="border-b border-line/50 last:border-b-0">
            {item.children?.length ? (
              <div>
                <div class="flex items-center gap-1">
                  <a
                    href={getLocalizedPath(item.path, lang)}
                    class:list={[
                      'flex-1 rounded-lg px-2 py-3 text-[0.95rem] font-semibold transition-colors',
                      isItemActive(item) ? 'text-petrol-900' : 'text-ink hover:text-petrol-900',
                    ]}
                    aria-current={isItemActive(item) ? 'page' : undefined}
                  >
                    {t(item.labelKey as UiKey)}
                  </a>
                  <button
                    type="button"
                    class="submenu-toggle inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-petrol-500 transition-colors hover:bg-white hover:text-petrol-800"
                    aria-expanded="false"
                    aria-controls={`submenu-${i}`}
                    aria-label={t('header.toggleSubmenu')}
                  >
                    <svg class="submenu-chevron h-4 w-4 transition-transform duration-200" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                </div>
                <div id={`submenu-${i}`} class="submenu hidden">
                  {item.groups?.length ? (
                    /* Gegliedertes Untermenü: dieselben Gruppen wie am Desktop, jede einzeln aufklappbar,
                       damit die Liste kurz bleibt. Die Gruppe der aktuellen Seite ist schon offen.
                       Die Knöpfe nutzen dieselbe Klasse wie die Pfeile der Hauptpunkte (Skript unten). */
                    <div class="mb-2 ml-3 border-l border-petrol-100 pl-3">
                      {item.groups.map((group, g) => {
                        const open = group.items.some((child) => isActive(child.path));
                        return (
                          <div>
                            <button
                              type="button"
                              class="submenu-toggle flex w-full items-center justify-between gap-3 rounded-lg px-2 py-2.5 text-left text-sm font-medium text-ink transition-colors hover:text-petrol-900"
                              aria-expanded={open ? 'true' : 'false'}
                              aria-controls={`nav-gruppe-mobil-${g}`}
                            >
                              {t(group.labelKey as UiKey)}
                              <svg
                                class:list={['submenu-chevron mr-0.5 h-4 w-4 shrink-0 text-petrol-500 transition-transform duration-200', open && 'rotate-180']}
                                viewBox="0 0 12 12"
                                fill="none"
                                aria-hidden="true"
                              >
                                <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </button>
                            <ul
                              id={`nav-gruppe-mobil-${g}`}
                              class:list={['mb-1.5 ml-2 flex flex-col border-l border-petrol-100 pl-2', !open && 'hidden']}
                            >
                              {group.items.map((child) => (
                                <li>
                                  <a
                                    href={getLocalizedPath(child.path, lang)}
                                    class:list={[
                                      'block rounded-lg px-2 py-2 text-sm transition-colors',
                                      isActive(child.path) ? 'font-semibold text-petrol-900' : 'text-ink-soft hover:text-petrol-900',
                                    ]}
                                    aria-current={isActive(child.path) ? 'page' : undefined}
                                  >
                                    {t(child.labelKey as UiKey)}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        );
                      })}
                      <div class="mt-1.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-line/70 px-2 pt-2 text-sm">
                        {item.more?.map((extra) =>
                          extra.tone ? (
                            <a
                              href={getLocalizedPath(extra.path, lang)}
                              class:list={['inline-flex items-center gap-2 py-1.5 font-semibold transition-opacity hover:opacity-75', toneClass[extra.tone]]}
                            >
                              <span class:list={['h-2 w-2 rounded-full', toneDot[extra.tone]]} aria-hidden="true"></span>
                              {t(extra.labelKey as UiKey)}
                            </a>
                          ) : (
                            <a
                              href={getLocalizedPath(extra.path, lang)}
                              class:list={[
                                'py-1.5 transition-colors hover:text-petrol-900',
                                isActive(extra.path) ? 'font-semibold text-petrol-900' : 'text-ink-soft',
                              ]}
                              aria-current={isActive(extra.path) ? 'page' : undefined}
                            >
                              {t(extra.labelKey as UiKey)}
                            </a>
                          )
                        )}
                        <a
                          href={getLocalizedPath(item.path, lang)}
                          class="ml-auto inline-flex items-center gap-1.5 py-1.5 font-semibold text-petrol-700 transition-colors hover:text-petrol-900"
                        >
                          {t('nav.allServices')}
                          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <path d="M3 8h9M9 5l3 3-3 3" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  ) : (
                    <ul class="mb-2 ml-3 flex flex-col border-l border-petrol-100 pl-3">
                      {item.children.map((child) =>
                        child.tone ? (
                          <li>
                            <a
                              href={getLocalizedPath(child.path, lang)}
                              class:list={['flex items-center gap-2 rounded-lg px-2 py-2 text-sm font-semibold transition-opacity hover:opacity-75', toneClass[child.tone]]}
                            >
                              <span class:list={['h-2 w-2 rounded-full', toneDot[child.tone]]} aria-hidden="true"></span>
                              {t(child.labelKey as UiKey)}
                            </a>
                          </li>
                        ) : (
                          <li>
                            <a
                              href={getLocalizedPath(child.path, lang)}
                              class:list={[
                                'block rounded-lg px-2 py-2 text-sm transition-colors',
                                isActive(child.path) ? 'font-semibold text-petrol-900' : 'text-ink-soft hover:text-petrol-900',
                              ]}
                              aria-current={isActive(child.path) ? 'page' : undefined}
                            >
                              {t(child.labelKey as UiKey)}
                            </a>
                          </li>
                        )
                      )}
                    </ul>
                  )}
                </div>
              </div>
            ) : (
              <a
                href={getLocalizedPath(item.path, lang)}
                class:list={[
                  'block rounded-lg px-2 py-3 text-[0.95rem] font-semibold transition-colors',
                  isItemActive(item) ? 'text-petrol-900' : 'text-ink hover:text-petrol-900',
                ]}
                aria-current={isItemActive(item) ? 'page' : undefined}
              >
                {t(item.labelKey as UiKey)}
              </a>
            )}
          </div>
        ))
      }
      <div class="mt-4 flex items-center justify-between gap-3">
        <LanguageSwitcher />
        <a href={bookingHref} class="btn-gold h-11 flex-1 justify-center" aria-label={t('cta.bookAria')}>
          {t('cta.book')}
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // Bewusst is:inline: NICHT durch Vite/Rolldown geschleust. Unter Astro 6 +
  // rolldown-vite zerlegt der React-Refresh-Wrapper sonst dieses gehostete
  // Skript („Missing field moduleType"), wodurch das Menü ohne Funktion bliebe.
  (function () {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;
    var iconOpen = toggle.querySelector('.menu-icon-open');
    var iconClose = toggle.querySelector('.menu-icon-close');

    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? toggle.dataset.labelClose || '' : toggle.dataset.labelOpen || '');
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
    }

    toggle.addEventListener('click', function () {
      setOpen(menu.classList.contains('hidden'));
    });

    // Untermenüs als Akkordeon auf-/zuklappen (Pfeil dreht sich).
    menu.querySelectorAll('.submenu-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('aria-controls');
        var panel = id ? document.getElementById(id) : null;
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (panel) panel.classList.toggle('hidden', open);
        var chevron = btn.querySelector('.submenu-chevron');
        if (chevron) chevron.classList.toggle('rotate-180', !open);
      });
    });

    // Beim Wechsel auf Desktop-Breite (xl) das mobile Menü schließen.
    window.matchMedia('(min-width: 1280px)').addEventListener('change', function (e) {
      if (e.matches) setOpen(false);
    });
  })();
</script>
