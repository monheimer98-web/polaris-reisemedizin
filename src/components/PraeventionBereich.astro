---
/**
 * Bereichsseite „Prävention & Lebensstil" (/praevention): Hero, Bereichs-
 * navigation, Einstieg nach Lebenslage, Angebote in drei Gruppen (ohne feste
 * Beträge, Hinweis auf die Beispielkosten), Arbeitsweise, was wir bewusst nicht
 * anbieten, häufige Fragen, Abschluss-Band. Alles in `.theme-praevention`
 * (Salbei); Kopf- und Fußzeile bleiben die der Praxis. Sprache aus der URL.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import PraeventionNav from './PraeventionNav.astro';
import CTA from './CTA.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import {
  PREVENTION_BOOKING_PATH,
  PREVENTION_COSTS_PATH,
  preventionCostNote,
  preventionDoctor,
  preventionEntryPoints,
  preventionGroups,
  preventionHub as hub,
  preventionOffers,
  preventionPath,
} from '../data/praevention';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const groups = preventionGroups
  .map((g) => ({ ...g, offers: preventionOffers.filter((o) => o.group === g.id) }))
  .filter((g) => g.offers.length > 0);
const entryPoints = preventionEntryPoints.filter((e) => preventionOffers.some((o) => o.slug === e.slug));
const crumbs = [{ label: t('nav.home'), path: getLocalizedPath('/', lang) }, { label: t('nav.preventionArea') }];
---

<BaseLayout title={hub.meta.title[lang]} description={hub.meta.description[lang]}>
  <div class="theme-praevention">
    <PageHero eyebrow={hub.meta.eyebrow[lang]} title={hub.meta.title[lang]} lead={hub.meta.lead[lang]}>
      <Breadcrumbs slot="breadcrumb" items={crumbs} label={t('content.breadcrumb')} />
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={getLocalizedPath(PREVENTION_BOOKING_PATH, lang)} class="btn-gold" aria-label={t('cta.bookAria')}>{t('cta.book')}</a>
        <a href="#angebote" class="btn-ghost">{lang === 'de' ? 'Angebote ansehen' : 'View services'}</a>
      </div>
      <p class="mt-6 flex items-center gap-2 text-sm text-ink-soft">
        <span class="h-1.5 w-1.5 rounded-full bg-gold-400" aria-hidden="true"></span>
        {preventionDoctor[lang]}
      </p>
    </PageHero>

    <PraeventionNav />

    <section class="u-container py-14 sm:py-16" aria-labelledby="einstieg">
      <h2 id="einstieg" class="text-2xl sm:text-3xl">{hub.entryTitle[lang]}</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          entryPoints.map((e) => (
            <li>
              <a
                href={getLocalizedPath(preventionPath(e.slug), lang)}
                class="group flex h-full items-center justify-between gap-3 rounded-2xl border border-petrol-100 bg-white px-5 py-4 font-medium text-petrol-900 shadow-[var(--shadow-soft)] transition-colors hover:border-gold-300"
              >
                <span>{e.label[lang]}</span>
                <svg class="h-4 w-4 shrink-0 text-gold-500 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="angebote" class="scroll-mt-24 border-y border-petrol-100 bg-petrol-50/60 py-14 sm:py-16">
      <div class="u-container space-y-14">
        {
          groups.map((g) => (
            <div>
              <p class="eyebrow"><span class="rule-gold" />{g.title[lang]}</p>
              <p class="mt-3 max-w-2xl text-ink-soft">{g.lead[lang]}</p>
              <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {g.offers.map((o) => (
                  <li>
                    <a
                      href={getLocalizedPath(preventionPath(o.slug), lang)}
                      class="card group flex h-full flex-col transition-shadow hover:shadow-[var(--shadow-card-hover)]"
                    >
                      <h3 class="text-xl">{o.shortName[lang]}</h3>
                      <p class="mt-3 flex-1 text-ink-soft">{o.teaser[lang]}</p>
                      <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-petrol-800">
                        {lang === 'de' ? 'Mehr erfahren' : 'Learn more'}
                        <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <p class="max-w-3xl text-sm text-ink-soft">
          {preventionCostNote[lang]}{' '}
          <a
            href={getLocalizedPath(PREVENTION_COSTS_PATH, lang)}
            class="font-semibold text-petrol-800 underline decoration-gold-400/50 underline-offset-4"
          >
            {lang === 'de' ? 'Beispielkosten ansehen' : 'View example fees'}
          </a>
        </p>
      </div>
    </section>

    <section class="u-container py-14 sm:py-16" aria-labelledby="arbeitsweise">
      <h2 id="arbeitsweise" class="text-2xl sm:text-3xl">{hub.principlesTitle[lang]}</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          hub.principles.map((p) => (
            <li class="rounded-2xl border border-petrol-100 bg-white/70 p-6">
              <p class="font-display text-lg font-semibold text-petrol-900">{p.title[lang]}</p>
              <p class="mt-2 text-ink-soft">{p.text[lang]}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 max-w-3xl rich-text">
        <h2>{hub.notOfferedTitle[lang]}</h2>
        <ul>
          {hub.notOffered[lang].map((item) => <li>{item}</li>)}
        </ul>
        <p>
          <a href={getLocalizedPath(PREVENTION_COSTS_PATH, lang)}>{lang === 'de' ? 'Beispielkosten Prävention' : 'Example fees for preventive care'}</a>
          {' · '}
          <a href={getLocalizedPath('/kosten', lang)}>{lang === 'de' ? 'Kosten und Abrechnung' : 'Fees and billing'}</a>
        </p>
      </div>

      <div id="fragen" class="mt-12 max-w-3xl scroll-mt-24">
        <div class="rich-text">
          <h2>{hub.faqTitle[lang]}</h2>
        </div>
        <div class="mt-4 divide-y divide-petrol-100 rounded-2xl border border-petrol-100 bg-white">
          {
            hub.faq.map((item) => (
              <details class="group px-5 py-4">
                <summary class="cursor-pointer list-none font-semibold text-petrol-900 marker:hidden">
                  <span class="flex items-start justify-between gap-4">
                    {item.q[lang]}
                    <span class="mt-0.5 text-gold-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </span>
                </summary>
                <p class="mt-3 text-ink-soft">{item.a[lang]}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <CTA title={hub.ctaTitle[lang]} lead={hub.ctaLead[lang]} note={hub.ctaNote[lang]} bookingPath={PREVENTION_BOOKING_PATH} />
  </div>
</BaseLayout>
