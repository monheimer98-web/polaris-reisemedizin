---
/**
 * Abschnitts-Darstellung einer `ClinicalPage` (Fließtext, Liste, Callout,
 * „Mehr dazu"-Links) plus optionaler FAQ-Block. Gemeinsam genutzt von den
 * Ratgeber- und Länderseiten; Sprache wird aus der URL abgeleitet.
 */
import Callout from './Callout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import type { ClinicalPage } from '../data/types';

interface Props {
  page: ClinicalPage;
}

const { page } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="space-y-12 sm:space-y-14">
  {
    page.sections.map((section) => (
      <section id={section.id} class="scroll-mt-24">
        <div class="rich-text">
          <h2>{section.heading[lang]}</h2>
          {section.body[lang].map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.list && (
            <ul>
              {section.list[lang].map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          )}
        </div>
        {section.callout && (
          <Callout variant={section.callout.variant} title={section.callout.title?.[lang]}>
            {section.callout.text[lang]}
          </Callout>
        )}
        {section.links && section.links.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-ink-soft">{t('content.moreOnTopic')}</span>
            {section.links.map((link) => (
              <a
                href={getLocalizedPath(link.path, lang)}
                class="group inline-flex items-center gap-1.5 rounded-full border border-petrol-100 bg-white px-3 py-1.5 text-sm font-medium text-petrol-800 transition-colors hover:border-gold-300 hover:bg-gold-50/50 hover:text-petrol-900"
              >
                {link.label[lang]}
                <svg
                  class="h-3.5 w-3.5 text-petrol-400 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </section>
    ))
  }
  {
    page.faq && page.faq.length > 0 && (
      <section id="fragen" class="scroll-mt-24">
        <div class="rich-text">
          <h2>{t('content.faqHeading')}</h2>
        </div>
        <div class="mt-4 divide-y divide-petrol-100 rounded-2xl border border-petrol-100 bg-white">
          {page.faq.map((item) => (
            <details class="group px-5 py-4">
              <summary class="cursor-pointer list-none font-semibold text-petrol-900 marker:hidden">
                <span class="flex items-start justify-between gap-4">
                  {item.q[lang]}
                  <span class="mt-0.5 text-gold-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 text-ink-soft">{item.a[lang]}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }
</div>
