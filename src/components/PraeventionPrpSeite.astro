---
/**
 * Unterseite „PRP bei Haarausfall“ (/praevention/haare/prp, DE und EN gleich).
 * Eigener Buchungsknopf für den PRP-Termin (pv-prp-erst, seit 21.11.2026 ohne
 * Haarsprechstunde davor), zweiter Knopf zur Haarsprechstunde. Welche Termine frei
 * sind, entscheidet die Praxissoftware (PRP_AB); die Seite nennt kein Datum.
 */
import ContentLayout from '../layouts/ContentLayout.astro';
import ClinicalSections from './ClinicalSections.astro';
import PraeventionAnfahrt from './PraeventionAnfahrt.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import { getSources } from '../data/sources';
import { preventionHub } from '../data/praevention';
import { haarePrp } from '../data/praevention/angebote/haare';
import { SITE_URL } from '../config/site';
import { praeventionThema, prpGegenanzeigen } from '../data/praevention/schema';

const lang = getLangFromUrl(Astro.url);
const de = lang === 'de';
const page = haarePrp;
const related = (page.related ?? []).map((item) => ({ label: item.label[lang], path: getLocalizedPath(item.path, lang) }));
const faq = (page.faq ?? []).map((f) => ({ q: f.q[lang], a: f.a[lang] }));
const { faq: _faq, ...rest } = page;
const thema = praeventionThema('prp', lang, (pfad) => new URL(getLocalizedPath(pfad, lang), SITE_URL).href);
const about = thema ? { ...thema, contraindication: prpGegenanzeigen(lang) } : undefined;
---

<ContentLayout
  title={page.meta.title[lang]}
  description={page.meta.description[lang]}
  eyebrow={page.meta.eyebrow[lang]}
  lead={page.meta.lead[lang]}
  lastReviewed={page.lastReviewed}
  sources={getSources(page.sourceIds)}
  related={related}
  faq={faq}
  bookingType="pv-prp-erst"
  bookingLabel={de ? 'PRP-Termin buchen' : 'Book a PRP appointment'}
  secondaryBooking={{ type: 'pv-haare', label: de ? 'Zuerst die Haarsprechstunde buchen' : 'Book the hair consultation first' }}
  area="praevention"
  areaCurrent="haare"
  about={about}
  parent={{ label: de ? 'Haarsprechstunde' : 'Hair consultation', path: getLocalizedPath('/praevention/haare', lang) }}
  cta={{
    title: de ? 'PRP-Termin buchen' : 'Book a PRP appointment',
    lead: de
      ? 'Direkt buchbar, ohne Haarsprechstunde davor: ca. 260 € je Sitzung, Röhrchen eingeschlossen. Vor der ersten Behandlung klären wir Sie auf. Passt PRP nicht zu Ihrem Haarausfall, behandeln wir nicht.'
      : 'Bookable directly, without a hair consultation beforehand: approx. €260 per session, tubes included. Before the first treatment we explain everything. If PRP does not suit your hair loss, we do not treat.',
    note: preventionHub.ctaNote[lang],
  }}
>
  <ClinicalSections page={{ ...rest, faq: undefined }} />
  <PraeventionAnfahrt />
  {
    faq.length > 0 && (
      <div class="mt-12 sm:mt-14">
        <ClinicalSections page={{ ...rest, sections: [], faq: page.faq }} />
      </div>
    )
  }
</ContentLayout>
