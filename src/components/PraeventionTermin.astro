---
/**
 * Terminseite der Themenwelt „Prävention" (/praevention/termin): bettet die
 * Buchung mit `bereich=praevention` ein, Reise-Terminarten bleiben auf /termin.
 * Mit `preventionOnlineBooking = false` stehen statt der Buchung Telefon und
 * E-Mail. Indexierbar (eigener Inhalt: was zuerst buchen, Ablauf in zwei
 * Terminen); keine festen Beträge, sondern Hinweis auf die Beispielkosten.
 * Sprache aus der URL.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import PraeventionNav from './PraeventionNav.astro';
import BookingEmbed from './BookingEmbed.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { BOOKING_PATH } from '../config/nav';
import { site } from '../config/site';
import {
  PREVENTION_COSTS_PATH,
  PREVENTION_PATH,
  preventionCostNote,
  preventionDoctor,
  preventionHub,
  preventionOffers,
  preventionOnlineBooking,
  preventionPath,
} from '../data/praevention';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const de = lang === 'de';
const title = de ? 'Termin in der Prävention' : 'Prevention appointment';
const lead = de
  ? 'Wählen Sie Ihr Angebot und buchen Sie den Ersttermin. Dort besprechen wir, was sinnvoll ist, und nehmen Blut ab. Den Befundtermin legen wir im Ersttermin gemeinsam fest.'
  : 'Choose your service and book the first appointment. There we discuss what makes sense and take a blood sample. We arrange the results appointment together during the first appointment.';
const description = de
  ? 'Termin für Gesundheitscheck, Laborwerte-Check oder Sprechstunde Gewicht und Stoffwechsel in Langenfeld bei Düsseldorf: zwei Termine, schriftliches Ergebnis.'
  : 'Appointment for a health check-up, lab value check or weight and metabolism consultation in Langenfeld near Düsseldorf: two appointments, written results.';
const schritte = de
  ? [
      { titel: 'Ersttermin', text: 'Wir besprechen Ihre Fragen und legen fest, welche Werte sinnvoll sind. Dann nehmen wir Blut ab. Die voraussichtlichen Kosten erhalten Sie vorher schriftlich.' },
      { titel: 'Befundtermin', text: 'Wenn alle Werte vorliegen, meist nach wenigen Tagen bis einer Woche: Wir erklären Ihre Ergebnisse, und Sie bekommen sie schriftlich. Beim Gesundheitscheck untersuchen wir Sie in diesem Termin.' },
    ]
  : [
      { titel: 'First appointment', text: 'We discuss your questions and decide which values make sense. Then we take a blood sample. You receive the expected costs in writing beforehand.' },
      { titel: 'Results appointment', text: 'Once all results are in, usually after a few days to a week: we explain your results and give them to you in writing. For the health check-up, the examination takes place in this appointment.' },
    ];
const faq = de
  ? [
      { q: 'Was buche ich zuerst?', a: 'Den Ersttermin des passenden Angebots. Den Befundtermin vereinbaren wir im Ersttermin mit Ihnen.' },
      { q: 'Warum zwei Termine?', a: 'Blutwerte brauchen einige Tage im Labor. Im zweiten Termin liegen alle Ergebnisse vor, und wir nehmen uns Zeit, sie mit Ihnen durchzugehen.' },
      { q: 'Zu welcher Uhrzeit liegen die Ersttermine?', a: 'Die freien Zeiten sehen Sie in der Buchung, je nach Woche auch am Abend oder am Samstag. Ihre Blutprobe geht mit der nächsten Abholung ins Labor. Muss ein Wert schneller dort sein, sagen wir es Ihnen vorher.' },
      { q: 'Muss ich zur Blutabnahme nüchtern kommen?', a: 'In der Regel nicht. Wenn ein Wert nüchtern bestimmt werden sollte, sagen wir es Ihnen vor dem Termin.' },
      { q: 'Kann ich Befunde vorher schicken?', a: 'Bitte bringen Sie vorhandene Befunde zum Termin mit. Schicken Sie Gesundheitsdaten bitte nicht per E-Mail.' },
      { q: 'Kann ich telefonisch buchen?', a: 'Ja. Rufen Sie uns an, wir finden gemeinsam den passenden Termin.' },
    ]
  : [
      { q: 'What do I book first?', a: 'The first appointment of the right service. We arrange the results appointment with you during the first appointment.' },
      { q: 'Why two appointments?', a: 'Blood tests take a few days at the laboratory. At the second appointment all results are in, and we take time to go through them with you.' },
      { q: 'At what time are the first appointments?', a: 'You can see the free times in the booking, depending on the week also in the evening or on Saturday. Your blood sample goes to the laboratory with the next collection. If a value needs to get there sooner, we tell you beforehand.' },
      { q: 'Do I need to fast for the blood sample?', a: 'Usually not. If a value should be measured fasting, we will tell you before the appointment.' },
      { q: 'Can I send results in advance?', a: 'Please bring existing results to the appointment. Please do not send health data by e-mail.' },
      { q: 'Can I book by phone?', a: 'Yes. Call us and we will find a suitable appointment together.' },
    ];
const crumbs = [
  { label: t('nav.home'), path: getLocalizedPath('/', lang) },
  { label: t('nav.preventionArea'), path: getLocalizedPath(PREVENTION_PATH, lang) },
  { label: de ? 'Termin' : 'Appointment' },
];
---

<BaseLayout title={title} description={description}>
  <div class="theme-praevention">
    <PageHero eyebrow={de ? 'Prävention' : 'Prevention'} title={title} lead={lead}>
      <Breadcrumbs slot="breadcrumb" items={crumbs} label={t('content.breadcrumb')} />
      <p class="mt-6 text-sm text-ink-soft">
        {de ? 'Im falschen Bereich gelandet? ' : 'In the wrong section? '}
        <a href={getLocalizedPath(BOOKING_PATH, lang)} class="font-semibold text-petrol-700 underline decoration-gold-400/50 underline-offset-4">
          {de ? 'Termine für Reisemedizin und Impfungen finden Sie hier.' : 'Appointments for travel medicine and vaccinations are here.'}
        </a>
      </p>
    </PageHero>

    <PraeventionNav current="termin" />

    <section class="u-container py-14 sm:py-16">
      {
        preventionOnlineBooking ? (
          <BookingEmbed embedUrl={site.booking.embedUrl} title={title} bereich="praevention" />
        ) : (
          <div class="card max-w-3xl">
            <h2 class="text-2xl">{de ? 'Termin vereinbaren' : 'Arrange an appointment'}</h2>
            <p class="mt-3 text-ink-soft">
              {de
                ? 'Die Online-Buchung für diesen Bereich richten wir gerade ein. Rufen Sie uns bitte an oder schreiben Sie uns; wir finden gemeinsam den passenden Termin.'
                : 'We are currently setting up online booking for this section. Please call or e-mail us and we will find a suitable appointment together.'}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={site.contact.phoneHref} class="btn-primary">{site.contact.phone}</a>
              <a href={site.contact.emailHref} class="btn-ghost">{site.contact.email}</a>
            </div>
          </div>
        )
      }
    </section>

    <section class="u-container pb-14 sm:pb-16" aria-labelledby="ablauf">
      <h2 id="ablauf" class="text-2xl sm:text-3xl">{de ? 'So läuft es mit Blutwerten ab' : 'How it works with blood tests'}</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-2">
        {
          schritte.map((s, i) => (
            <li class="flex gap-4 rounded-2xl border border-petrol-100 bg-white/70 p-5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-petrol-800 text-sm font-semibold text-cream tabular-nums">
                {i + 1}
              </span>
              <div>
                <p class="font-semibold text-petrol-900">{s.titel}</p>
                <p class="mt-1 text-ink-soft">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="u-container pb-14 sm:pb-16">
      <h2 class="text-2xl sm:text-3xl">{de ? 'Unsere Angebote' : 'Our services'}</h2>
      <ul class="mt-6 divide-y divide-petrol-100 rounded-2xl border border-petrol-100 bg-white">
        {
          preventionOffers.map((o) => (
            <li class="grid gap-1 px-5 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
              <a
                href={getLocalizedPath(preventionPath(o.slug), lang)}
                class="font-semibold text-petrol-900 underline decoration-gold-400/50 underline-offset-4"
              >
                {o.shortName[lang]}
              </a>
              <p class="text-sm leading-relaxed text-ink-soft">{o.facts.appointments[lang]}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 max-w-3xl text-sm text-ink-soft">
        {preventionCostNote[lang]}{' '}
        <a
          href={getLocalizedPath(PREVENTION_COSTS_PATH, lang)}
          class="font-semibold text-petrol-800 underline decoration-gold-400/50 underline-offset-4"
        >
          {de ? 'Beispielkosten ansehen' : 'View example fees'}
        </a>
      </p>
      <p class="mt-3 max-w-3xl text-sm text-ink-soft">{preventionHub.ctaNote[lang]} {preventionDoctor[lang]}</p>
    </section>

    <section id="fragen" class="u-container scroll-mt-32 pb-16 sm:pb-20">
      <div class="max-w-3xl">
        <div class="rich-text">
          <h2>{t('content.faqHeading')}</h2>
        </div>
        <div class="mt-4 divide-y divide-petrol-100 rounded-2xl border border-petrol-100 bg-white">
          {
            faq.map((item) => (
              <details class="group px-5 py-4">
                <summary class="cursor-pointer list-none font-semibold text-petrol-900 marker:hidden">
                  <span class="flex items-start justify-between gap-4">
                    {item.q}
                    <span class="mt-0.5 text-gold-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                  </span>
                </summary>
                <p class="mt-3 text-ink-soft">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
